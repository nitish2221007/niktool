# Recommended offline provider. Gemma 3 4B is often informally called "Gemma 4B".
# Install Ollama once, pull the model from the UI, then generation works offline.
AI_PROVIDER=ollama
OLLAMA_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_WEB_RESEARCH_ENABLED=false

# Optional cloud providers: 'gemini' or 'nvidia'

# NVIDIA NIM API (Free trial key at https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# The existing NikTool repository. The default is the parent folder.
NIKTOOL_SITE_ROOT=..

# Optional: copy validated folders here as well as keeping the run artifact.
# Use ../tools to write directly into this website after generation.
# NIKTOOL_OUTPUT_ROOT=../tools

WEB_RESEARCH_ENABLED=true
SEARCH_TIMEOUT_SECONDS=12
